{
  "schema": "magireco-reviewed-story-zh-dialogue-map-v1",
  "scope": "ac7112_voice_bound_dialogue",
  "status": "machine_draft_pending_owner",
  "translations": [
    {"ja": "…っ！うん！", "zh": "……！嗯！", "status": "machine_draft_pending_owner"},
    {"ja": "（悲鳴）", "zh": "（惨叫）", "status": "machine_draft_pending_owner"},
    {"ja": "（笑みアドリブ）", "zh": "（笑声）", "status": "machine_draft_pending_owner"},
    {"ja": "諦めなきゃいけないようなことなんて", "zh": "根本没有什么事\n是必须放弃的。", "status": "machine_draft_pending_owner"},
    {"ja": "今までにないほど\nうまくいってる", "zh": "前所未有地顺利。", "status": "machine_draft_pending_owner"},
    {"ja": "鹿目さん…", "zh": "鹿目同学……", "status": "machine_draft_pending_owner"},
    {"ja": "鹿目さんを救えるかもしれない", "zh": "也许能救下鹿目同学。", "status": "machine_draft_pending_owner"},
    {"ja": "美樹さ－ん！", "zh": "美树同学——！", "status": "machine_draft_pending_owner"},
    {"ja": "美樹さん！", "zh": "美树同学！", "status": "machine_draft_pending_owner"},
    {"ja": "魔法少女になった以上 腐ってたって始まんないわ", "zh": "既然已经成为魔法少女，\n消沉下去也无济于事。", "status": "machine_draft_pending_owner"},
    {"ja": "神浜の魔女はこんなもんじゃなくて", "zh": "神滨的魔女可不止这种程度。", "status": "machine_draft_pending_owner"},
    {"ja": "私\nきっとひとりじゃ魔法少女になるか決められなかった", "zh": "如果只有我一个人，\n一定决定不了是否成为魔法少女。", "status": "machine_draft_pending_owner"},
    {"ja": "私達負けなかったよ！", "zh": "我们没有输！", "status": "machine_draft_pending_owner"},
    {"ja": "私達がマミさんを助けよう！", "zh": "我们去救麻美学姐吧！", "status": "machine_draft_pending_owner"},
    {"ja": "戦おう\nみんなで一緒に", "zh": "战斗吧，\n大家一起！", "status": "machine_draft_pending_owner"},
    {"ja": "あたしだけじゃなくって", "zh": "不只是我……", "status": "machine_draft_pending_owner"},
    {"ja": "あたしだって 負けてられないんだから！", "zh": "我也不能输啊！", "status": "machine_draft_pending_owner"},
    {"ja": "あっぶな！\nどういうつもりよ！", "zh": "好险！\n你想干什么！", "status": "machine_draft_pending_owner"},
    {"ja": "あのね", "zh": "那个……", "status": "machine_draft_pending_owner"},
    {"ja": "ありがとう\nまどか", "zh": "谢谢你，\n小圆。", "status": "machine_draft_pending_owner"},
    {"ja": "いくよー！", "zh": "要上了——！", "status": "machine_draft_pending_owner"},
    {"ja": "う、うわっ！", "zh": "呜、呜哇！", "status": "machine_draft_pending_owner"},
    {"ja": "うん！", "zh": "嗯！", "status": "machine_draft_pending_owner"},
    {"ja": "え？え？", "zh": "咦？咦？", "status": "machine_draft_pending_owner"},
    {"ja": "ギリ勝ち…\nだったけどね…", "zh": "虽然只是险胜……", "status": "machine_draft_pending_owner"},
    {"ja": "くらえええっ！", "zh": "接招——！", "status": "machine_draft_pending_owner"},
    {"ja": "ごめんなさい\n必死だったものでつい…", "zh": "对不起，\n我一着急就不小心……", "status": "machine_draft_pending_owner"},
    {"ja": "さやかちゃん", "zh": "沙耶香。", "status": "machine_draft_pending_owner"},
    {"ja": "さやかちゃん！", "zh": "沙耶香！", "status": "machine_draft_pending_owner"},
    {"ja": "そっか…", "zh": "这样啊……", "status": "machine_draft_pending_owner"},
    {"ja": "それじゃ行くわよ！", "zh": "那就上吧！", "status": "machine_draft_pending_owner"},
    {"ja": "ちょ！？", "zh": "等！？", "status": "machine_draft_pending_owner"},
    {"ja": "でも\nまだ負けてないもん", "zh": "可是，\n我们还没有输。", "status": "machine_draft_pending_owner"},
    {"ja": "でも\nマミさんがいたから魔法少女になって", "zh": "可是，因为有麻美学姐，\n我才成为了魔法少女……", "status": "machine_draft_pending_owner"},
    {"ja": "はい！", "zh": "是！", "status": "machine_draft_pending_owner"},
    {"ja": "ひあああああ！", "zh": "呀啊啊啊啊！", "status": "machine_draft_pending_owner"},
    {"ja": "まだ何も始めてないんだよ？", "zh": "明明什么都还没开始吧？", "status": "machine_draft_pending_owner"},
    {"ja": "まどか", "zh": "小圆。", "status": "machine_draft_pending_owner"},
    {"ja": "まどか！", "zh": "小圆！", "status": "machine_draft_pending_owner"},
    {"ja": "もしかしたらこの時間軸でなら…\n本当に…", "zh": "也许在这条时间线上……\n真的可以……", "status": "machine_draft_pending_owner"},
    {"ja": "やばっ！", "zh": "糟了！", "status": "machine_draft_pending_owner"},
    {"ja": "っ…！", "zh": "……！", "status": "machine_draft_pending_owner"},
    {"ja": "！", "zh": "！", "status": "machine_draft_pending_owner"}
  ]
}
