  "translations": [
    {"ja": "何も選ばなかった", "zh": "什么都没有选择。", "status": "machine_draft_pending_owner"},
    {"ja": "私\nまだまだですけど", "zh": "我还差得远呢。", "status": "machine_draft_pending_owner"},
    {"ja": "私達は\n名前も聞かず\n連絡先も交換しないまま別れた", "zh": "我们连名字都没问，\n也没有交换联系方式，\n就这样分别了。", "status": "machine_draft_pending_owner"},
    {"ja": "私は\n選ばずに\n見捨てた", "zh": "我没有做出选择，\n而是抛下了她。", "status": "machine_draft_pending_owner"},
    {"ja": "私はあの日", "zh": "那一天，我……", "status": "machine_draft_pending_owner"},
    {"ja": "私も\n手持ちがないの", "zh": "我手上也没有。", "status": "machine_draft_pending_owner"},
    {"ja": "死ぬかと思いました…\nありがとうございます！", "zh": "我还以为自己要死了……\n谢谢你！", "status": "machine_draft_pending_owner"},
    {"ja": "危ない！", "zh": "危险！", "status": "machine_draft_pending_owner"},
    {"ja": "あ\nあのぉ…", "zh": "那、那个……", "status": "machine_draft_pending_owner"},
    {"ja": "あ、ああっ…", "zh": "啊、啊……", "status": "machine_draft_pending_owner"},
    {"ja": "あ…", "zh": "啊……", "status": "machine_draft_pending_owner"},
    {"ja": "ああああやまらないでください！", "zh": "请、请不要道歉！", "status": "machine_draft_pending_owner"},
    {"ja": "あの子は\nずっと手を振っていた", "zh": "那个孩子一直在挥手。", "status": "machine_draft_pending_owner"},
    {"ja": "あの子も不安だったんだ", "zh": "那个孩子也很不安。", "status": "machine_draft_pending_owner"},
    {"ja": "うん", "zh": "嗯。", "status": "machine_draft_pending_owner"},
    {"ja": "うん…", "zh": "嗯……", "status": "machine_draft_pending_owner"},
    {"ja": "え？", "zh": "咦？", "status": "machine_draft_pending_owner"},
    {"ja": "お互い頑張りましょう！", "zh": "我们一起努力吧！", "status": "machine_draft_pending_owner"},
    {"ja": "お互い頑張ろう", "zh": "我们一起努力吧。", "status": "machine_draft_pending_owner"},
    {"ja": "ごめん…", "zh": "对不起……", "status": "machine_draft_pending_owner"},
    {"ja": "ずっと\n振っていた", "zh": "一直在挥手。", "status": "machine_draft_pending_owner"},
    {"ja": "そ\nそうですよね！", "zh": "是、是啊！", "status": "machine_draft_pending_owner"},
    {"ja": "その…\nグリーフシードとか…", "zh": "那个……\n悲叹之种之类的……", "status": "machine_draft_pending_owner"},
    {"ja": "それじゃ", "zh": "那么……", "status": "machine_draft_pending_owner"},
    {"ja": "っ！", "zh": "！", "status": "machine_draft_pending_owner"},
    {"ja": "ッハァハァ…うわ", "zh": "哈、哈……呜哇。", "status": "machine_draft_pending_owner"},
    {"ja": "でも…\nごめん", "zh": "可是……\n对不起。", "status": "machine_draft_pending_owner"},
    {"ja": "とんでもないです！", "zh": "哪里的事！", "status": "machine_draft_pending_owner"},
    {"ja": "はあああっ…", "zh": "哈啊啊……", "status": "machine_draft_pending_owner"},
    {"ja": "はいっ！", "zh": "好的！", "status": "machine_draft_pending_owner"},
    {"ja": "みなさんの分のグリーフシードも取れるように頑張りますね！", "zh": "我会努力，\n争取连大家的悲叹之种也一起拿到！", "status": "machine_draft_pending_owner"}
  ]
}
