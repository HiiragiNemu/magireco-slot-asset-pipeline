  "translations": [
    {"ja": "！", "zh": "！", "status": "machine_draft_pending_owner"},
    {"ja": "…", "zh": "……", "status": "machine_draft_pending_owner"},
    {"ja": "本当のマミさんは…", "zh": "真正的麻美学姐……", "status": "machine_draft_pending_owner"},
    {"ja": "成功しましたね！", "zh": "成功了呢！", "status": "machine_draft_pending_owner"},
    {"ja": "見滝原に戻らなきゃ！", "zh": "得回见泷原才行！", "status": "machine_draft_pending_owner"},
    {"ja": "全部…\n私のせいなの…", "zh": "全部……\n都是我的错……", "status": "machine_draft_pending_owner"},
    {"ja": "神浜市全域を襲っていた暴風雨は収まりを見せました", "zh": "袭击神滨市全境的暴风雨\n已经开始平息。", "status": "machine_draft_pending_owner"},
    {"ja": "世話が焼けるぜ…", "zh": "真让人操心啊……", "status": "machine_draft_pending_owner"},
    {"ja": "あ…", "zh": "啊……", "status": "machine_draft_pending_owner"},
    {"ja": "アンタの願い\n届くといいな", "zh": "希望你的愿望\n能够传达到。", "status": "machine_draft_pending_owner"},
    {"ja": "いけない…\nここで鹿目さんが見滝原に帰ったら…", "zh": "不行……\n如果鹿目同学现在回见泷原……", "status": "machine_draft_pending_owner"},
    {"ja": "いろは", "zh": "彩羽。", "status": "machine_draft_pending_owner"},
    {"ja": "うん！", "zh": "嗯！", "status": "machine_draft_pending_owner"},
    {"ja": "え！", "zh": "咦！", "status": "machine_draft_pending_owner"},
    {"ja": "え…！", "zh": "咦……！", "status": "machine_draft_pending_owner"},
    {"ja": "ごめんなさい…私…", "zh": "对不起……我……", "status": "machine_draft_pending_owner"},
    {"ja": "コネクト！", "zh": "连携！", "status": "machine_draft_pending_owner"},
    {"ja": "ずっと無理をしてたかも", "zh": "我可能一直都在勉强自己。", "status": "machine_draft_pending_owner"},
    {"ja": "スーパーセルも進路を変え", "zh": "超级单体风暴也改变了路径，", "status": "machine_draft_pending_owner"},
    {"ja": "それって\nワルプルギスの夜が見滝原に！？", "zh": "那岂不是说，\n魔女之夜要去见泷原！？", "status": "machine_draft_pending_owner"},
    {"ja": "っ！！", "zh": "……！！", "status": "machine_draft_pending_owner"},
    {"ja": "ティロ！\nデュエット！", "zh": "缇罗！\n二重奏！", "status": "machine_draft_pending_owner"},
    {"ja": "はい！", "zh": "是！", "status": "machine_draft_pending_owner"},
    {"ja": "ふふ", "zh": "呵呵。", "status": "machine_draft_pending_owner"},
    {"ja": "ほどけるぞ！\n急げ！", "zh": "要松开了！\n快！", "status": "machine_draft_pending_owner"},
    {"ja": "ほら行くわよ！", "zh": "好了，要上了！", "status": "machine_draft_pending_owner"},
    {"ja": "まどかちゃん！", "zh": "小圆！", "status": "machine_draft_pending_owner"},
    {"ja": "マミさん帰ってきて！", "zh": "麻美学姐，快回来！", "status": "machine_draft_pending_owner"},
    {"ja": "マミさんは あたし達を導いてくれる強い先輩だったけど…", "zh": "麻美学姐曾是引导我们的\n强大前辈，可是……", "status": "machine_draft_pending_owner"},
    {"ja": "やった－！", "zh": "成功啦——！", "status": "machine_draft_pending_owner"},
    {"ja": "やった！", "zh": "成功了！", "status": "machine_draft_pending_owner"},
    {"ja": "よかった～", "zh": "太好了——", "status": "machine_draft_pending_owner"}
  ]
