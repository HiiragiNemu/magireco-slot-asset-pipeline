  "blocking_reasons": [
    {
      "code": "family_incomplete",
      "detail": "Four of the thirteen registered ac1101 events have no READY production manifest in v20 or v23, so the nine-event subset omits content that static event and Z2D evidence assigns to the same family."
    },
    {
      "code": "mutually_exclusive_title_variants",
      "detail": "ac1101_001, ac1101_008, ac1101_009 and ac1101_010 repeat the same title dialogue while selecting white/red and S/L-plus-Kuroe presentation variants. A single linear concatenation would play alternative title variants consecutively."
    },
    {
      "code": "win_lose_and_recovery_branches_unresolved",
      "detail": "Official DGM and sound labels distinguish ac1101_005 as a lose outcome, ac1101_006 as a win outcome, ac1101_011 as a second-game introduction, and ac1101_012/ac1101_013 as recovery-win content. No accepted runtime transition trace identifies the valid branch paths and joins."
    },
    {
      "code": "ac1101_002_voice_timing_unresolved",
      "detail": "The ac1101_002 voice-bound Z2D row is marked gdb_relation_without_decoded_frame, and no v20/v23 production manifest binds its final presentation time."
    },
    {
      "code": "mixed_layer_compositions_missing",
      "detail": "ac1101_006, ac1101_012 and ac1101_013 are catalogued as mixed_full_frame_and_components and have no accepted composition plan. Their victory sparkle/logo layers and loop intervals require evidence-bound composition before any natural branch can close."
    },
    {
      "code": "registration_order_is_not_playback_order",
      "detail": "event_info.csv proves only contiguous registration indices. It contains no transition edges and therefore cannot justify natural playback order by itself."
    }
  ],
